# Ignore all hidden files/dirs by default
.*
!.gitignore
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# Emitted next to source by tsc (vite.config.ts -> vite.config.js/.d.ts/.map)
apps/web/vite.config.js
apps/web/vite.config.js.map
apps/web/vite.config.d.ts
apps/web/vite.config.d.ts.map
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editors / OS
.DS_Store
.vscode/
.idea/

# pnpm
.pnpm-store/

# Local tooling output (machine-state, ephemeral)
scripts/outputs/

# Agent instructions (kept out of VCS)
/AGENTS.md

# PGlite persisted test databases
test-pgdata/
test-pgdata-pglite/
test-pgdata-pricing/
test-pgdata-shipments/
test-pgdata-tracking/
test-pgdata-cod/
