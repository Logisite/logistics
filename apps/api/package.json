{
  "name": "@logistics/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "prebuild": "pnpm -F @logistics/db build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm -F @logistics/db build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "pnpm -F @logistics/db build",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --reporter=verbose",
    "openapi:generate": "tsx src/openapi/generate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-postgis": "^0.2.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@logistics/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.36.4",
    "express": "^5.0.0",
    "express-zod-api": "^29.3.4",
    "jose": "^6.2.9",
    "postgres": "^3.4.9",
    "resend": "^6.20.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.0"
  }
}