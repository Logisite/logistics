# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/logistics

# API
PORT=3000

# Origin of the FRONTEND, not this API. Drives the CORS allowlist and the links
# in transactional email (/verify-email, /set-password, /reset-password).
# Vite dev serves on 5173; `vite preview` serves on 4173.
APP_URL=http://localhost:5173

# Extra CORS origins beyond APP_URL, comma separated. Leave empty unless you need
# a second origin (preview deploy, Storybook). Never use a wildcard: this API
# authenticates with a Bearer token, so reflection is unnecessary and unsafe.
CORS_ALLOWED_ORIGINS=

# Base URL THIS API is reachable at. Advertised as the OpenAPI server URL.
# Defaults to APP_URL when unset.
API_PUBLIC_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# S3-compatible object storage (POD images)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
