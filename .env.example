# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/logistics

# API
PORT=3000

# Resend (transactional email)
RESEND_API_KEY=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# S3-compatible object storage (POD images)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
